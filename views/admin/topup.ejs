<%- include('_header') %>
<div class="a-section-head">
  <div>
    <% if (single) { %>
      <h3><a href="/admin/boost/topup" class="a-muted">Nạp game</a> › <%= single.game_name %> › <%= single.name %></h3>
      <p class="a-muted a-small">Kéo nút ⠿ để đổi thứ tự gói. Tắt “Nhận đơn” để tạm ngưng gói mà vẫn hiển thị.</p>
    <% } else { %>
      <h3>Nạp game theo game</h3>
      <p class="a-muted a-small">Danh mục Nạp game tạo ở mục <a href="/admin/categories">Danh mục</a> (chọn loại Nạp game, chọn UID hoặc LOG). Bên trong là các gói nạp.</p>
    <% } %>
  </div>
  <div class="a-actions">
    <% if (single) { %>
      <a class="a-btn a-ghost" href="/game/<%= single.game_slug %>/<%= single.slug %>" target="_blank" rel="noopener"><%- I('eye') %> Xem ngoài web</a>
    <% } else if (parents.length) { %>
      <button type="button" class="a-btn" data-acc-all="open">Mở tất cả</button>
      <button type="button" class="a-btn" data-acc-all="close">Thu gọn</button>
    <% } %>
  </div>
</div>
<% if (!parents.length) { %><div class="a-card a-empty">Chưa có danh mục Nạp game nào. Vào <a href="/admin/categories">Danh mục</a> → Thêm danh mục → chọn loại <b>Nạp game</b>.</div><% } %>
<% parents.forEach(pc => { %>
<section class="a-acc<%= single ? ' open' : '' %>" id="tparent-<%= pc.id %>" data-acc="topup-parent-<%= pc.id %>">
  <div class="a-acc-head">
    <button type="button" class="a-acc-toggle" data-acc-toggle>
      <%- include('partials/thumb', { img: pc.image || pc.game_image, name: pc.name, color: pc.game_color, size: 'sm' }) %>
      <span class="a-acc-title"><b><%= pc.game_name %> › <%= pc.name %></b><small><%= pc.packages.length %> gói · nhập <%= pc.method === 'uid' ? 'UID' : 'LOG (tài khoản / mật khẩu)' %><%= pc.is_active ? '' : ' · đang ẩn' %></small></span>
      <span class="a-chevron"><%- I('caret-down') %></span>
    </button>
    <div class="a-actions">
      <button type="button" class="a-btn a-ghost" data-modal-url="/admin/categories/form?id=<%= pc.id %>" data-modal-title="Sửa danh mục Nạp game"><%- I('edit') %> <span class="a-hide-sm">Sửa</span></button>
      <button type="button" class="a-btn a-soft" data-modal-url="/admin/boost/packages/form?category_id=<%= pc.sub.id %>" data-modal-title="Thêm gói nạp – <%= pc.name %>"><%- I('plus') %> Thêm gói</button>
    </div>
  </div>
  <div class="a-acc-body">
    <div class="a-table-wrap">
      <table class="a-table">
        <thead><tr><th class="a-w-move"></th><th>Gói</th><th class="a-num">Giá</th><th>SL / đơn vị</th><th class="a-num">Đã nạp</th><th class="a-center">Nhận đơn</th><th class="a-center">Hiển thị</th><th class="a-right">Thao tác</th></tr></thead>
        <tbody>
        <% if (!pc.packages.length) { %><tr><td colspan="8" class="a-empty">Chưa có gói nạp nào.</td></tr><% } %>
        <% pc.packages.forEach((p, i) => { %>
          <tr class="<%= p.is_active ? '' : 'a-row-off' %>">
            <td><%- include('partials/move', { kind: 'boost-packages', id: p.id, first: i === 0, last: i === pc.packages.length - 1 }) %></td>
            <td><div class="a-item">
              <% if (p.image) { %><img src="<%= p.image %>" class="a-avatar sm" alt="" loading="lazy"><% } else { %><span class="a-bx-ico" style="--ic:<%= p.icon_color %>"><%- I(p.icon) %></span><% } %>
              <div><b><%= p.name %></b><% if (p.badge) { %> <span class="a-tag red"><%= p.badge %></span><% } %><div class="a-muted a-small"><%= p.eta ? '⏱ ' + p.eta : '' %></div></div>
            </div></td>
            <td class="a-num"><b><%= H.money(p.price) %></b><% if (p.old_price) { %><div class="a-muted a-small"><del><%= H.money(p.old_price) %></del></div><% } %></td>
            <td class="a-small"><%= p.min_qty %>–<%= p.max_qty %> <%= p.unit %></td>
            <td class="a-num"><%= p.sold_count.toLocaleString('vi-VN') %></td>
            <td class="a-center"><label class="a-switch" title="Nhận đơn"><input type="checkbox" data-toggle-url="/admin/boost/packages/<%= p.id %>/pause" data-on-msg="Đã mở lại nhận đơn" data-off-msg="Đã tạm ngưng nhận đơn" <%= p.is_paused ? '' : 'checked' %>><span></span></label></td>
            <td class="a-center"><%- include('partials/switch', { kind: 'boost-packages', id: p.id, on: p.is_active, disabled: false }) %></td>
            <td class="a-right"><div class="a-actions">
              <button type="button" class="a-icon-btn" data-modal-url="/admin/boost/packages/form?id=<%= p.id %>" data-modal-title="Sửa gói nạp" title="Sửa"><%- I('edit') %></button>
              <form method="post" action="/admin/boost/packages/<%= p.id %>/delete" data-confirm="Xóa gói “<%= p.name %>”?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="a-icon-btn a-icon-danger" title="Xóa"><%- I('trash') %></button></form>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% }) %>
<%- include('_footer') %>
