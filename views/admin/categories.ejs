<%- include('_header') %>
<div class="a-section-head">
  <div>
    <h3>Danh mục theo game</h3>
    <p class="a-muted a-small">Bấm vào một game để xem và thêm danh mục của game đó. Bấm mũi tên để đổi thứ tự.</p>
  </div>
  <div class="a-actions">
    <button type="button" class="a-btn" data-acc-all="open">Mở tất cả</button>
    <button type="button" class="a-btn" data-acc-all="close">Thu gọn</button>
  </div>
</div>

<% if (!games.length) { %><div class="a-card a-empty">Chưa có game. <a href="/admin/games">Thêm game trước</a>.</div><% } %>
<% games.forEach(g => { %>
<section class="a-acc" id="game-<%= g.id %>" data-acc="cat-game-<%= g.id %>">
  <div class="a-acc-head">
    <button type="button" class="a-acc-toggle" data-acc-toggle>
      <%- include('partials/thumb', { img: g.image, name: g.name, color: g.color, size: 'sm' }) %>
      <span class="a-acc-title"><b><%= g.name %></b><small><%= g.cats.length %> danh mục<%= g.is_active ? '' : ' · game đang ẩn' %></small></span>
      <span class="a-chevron"><%- I('caret-down') %></span>
    </button>
    <button type="button" class="a-btn a-soft" data-modal-url="/admin/categories/form?game_id=<%= g.id %>" data-modal-title="Thêm danh mục – <%= g.name %>"><%- I('plus') %> Thêm danh mục</button>
  </div>
  <div class="a-acc-body">
    <div class="a-table-wrap">
      <table class="a-table">
        <thead><tr><th class="a-w-move"></th><th>Danh mục</th><th class="a-num">Sản phẩm</th><th class="a-num">Giá từ</th><th class="a-center">Hiển thị</th><th class="a-right">Thao tác</th></tr></thead>
        <tbody>
        <% if (!g.cats.length) { %><tr><td colspan="6" class="a-empty">Game này chưa có danh mục.</td></tr><% } %>
        <% g.cats.forEach((c, i) => { %>
          <tr>
            <td><%- include('partials/move', { kind: 'categories', id: c.id, first: i === 0, last: i === g.cats.length - 1 }) %></td>
            <td><div class="a-item">
              <% if (c.image && !c.image.startsWith('/img/catalog/')) { %><img src="<%= c.image %>" class="a-avatar sm" alt="" loading="lazy"><% } %>
              <div><b><%= c.name %></b> <% if (c.sale_type === 'boost') { %><span class="a-type-badge boost sm"><%- I('g-swords') %> Cày thuê</span><% } else if (c.sale_type === 'topup') { %><span class="a-type-badge topup sm"><%- I('g-gem') %> Nạp game</span><% } else if (c.sale_type === 'reroll') { %><span class="a-type-badge reroll sm"><%- I('refresh') %> Reroll</span><% } else { %><span class="a-type-badge vip sm"><%- I('star') %> VIP</span><% } %><% if (c.description) { %><div class="a-muted a-small a-trunc"><%= c.description %></div><% } %></div>
            </div></td>
            <% if (c.sale_type === 'boost') { %>
            <td class="a-num"><a href="/admin/boost/c/<%= c.id %>"><%= c.sub_count %> danh mục con</a><div class="a-muted a-small"><%= c.pkg_count %> gói</div></td>
            <td class="a-num"><%= c.pkg_min != null ? H.money(c.pkg_min) : '—' %></td>
            <% } else if (c.sale_type === 'topup') { %>
            <td class="a-num"><a href="/admin/boost/topup/<%= c.id %>"><%= c.pkg_count %> gói nạp</a></td>
            <td class="a-num"><%= c.pkg_min != null ? H.money(c.pkg_min) : '—' %></td>
            <% } else { %>
            <td class="a-num"><a href="/admin/<%= c.sale_type === 'reroll' ? 'reroll' : 'vip' %>#cat-<%= c.id %>"><%= c.product_count.toLocaleString('vi-VN') %> SP</a><% if (c.product_count !== c.available_count) { %><div class="a-muted a-small"><%= c.available_count %> đang bán</div><% } %></td>
            <td class="a-num"><%= c.min_price != null ? H.money(c.min_price) : '—' %></td>
            <% } %>
            <td class="a-center"><%- include('partials/switch', { kind: 'categories', id: c.id, on: c.is_active, disabled: false }) %></td>
            <td class="a-right"><div class="a-actions">
              <% if (c.sale_type === 'boost') { %><a class="a-btn a-xs a-soft" href="/admin/boost/c/<%= c.id %>"><%- I('layers') %> Danh mục con</a><% } else if (c.sale_type === 'topup') { %><a class="a-btn a-xs a-soft" href="/admin/boost/topup/<%= c.id %>"><%- I('layers') %> Gói nạp</a><% } %>
              <button type="button" class="a-icon-btn" data-modal-url="/admin/categories/form?id=<%= c.id %>" data-modal-title="Sửa danh mục" title="Sửa"><%- I('edit') %></button>
              <form method="post" action="/admin/categories/<%= c.id %>/delete" data-confirm="Xóa danh mục “<%= c.name %>” và <%= c.sale_type === 'boost' ? 'các danh mục con, gói' : c.sale_type === 'topup' ? 'các gói nạp' : 'các sản phẩm chưa bán' %> bên trong?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="a-icon-btn a-icon-danger" title="Xóa"><%- I('trash') %></button></form>
            </div></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% }) %>
<%- include('_footer') %>
