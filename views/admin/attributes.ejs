<%- include('_header') %>
<div class="a-card a-card-flush">
  <div class="a-card-head a-pad">
    <div>
      <h3>Danh sách thuộc tính</h3>
      <p class="a-muted a-small">Tạo sẵn thuộc tính (VD: Rank, Server, Số skin) và các giá trị. Khi thêm sản phẩm chỉ cần chọn, không phải gõ lại.</p>
    </div>
    <button type="button" class="a-btn a-primary" data-modal-url="/admin/attributes/form" data-modal-title="Thêm thuộc tính"><%- I('plus') %> Thêm thuộc tính</button>
  </div>
  <div class="a-table-wrap">
    <table class="a-table a-table-lg">
      <thead><tr><th class="a-w-move"></th><th>Thuộc tính</th><th>Giá trị</th><th class="a-right">Thao tác</th></tr></thead>
      <tbody>
      <% if (!attrs.length) { %><tr><td colspan="4" class="a-empty">Chưa có thuộc tính nào. Bấm “Thêm thuộc tính” để bắt đầu.</td></tr><% } %>
      <% attrs.forEach((a, i) => { %>
        <tr>
          <td><%- include('partials/move', { kind: 'attributes', id: a.id, first: i === 0, last: i === attrs.length - 1 }) %></td>
          <td><b><%= a.name %></b><div class="a-muted a-small"><%= a.values.length %> giá trị</div></td>
          <td><div class="a-chips">
            <% a.values.slice(0, 12).forEach(v => { %><span class="a-chip"><%= v %></span><% }) %>
            <% if (a.values.length > 12) { %><span class="a-chip a-chip-more">+<%= a.values.length - 12 %></span><% } %>
          </div></td>
          <td class="a-right"><div class="a-actions">
            <button type="button" class="a-icon-btn" data-modal-url="/admin/attributes/form?id=<%= a.id %>" data-modal-title="Sửa thuộc tính" title="Sửa"><%- I('edit') %></button>
            <form method="post" action="/admin/attributes/<%= a.id %>/delete" data-confirm="Xóa thuộc tính “<%= a.name %>”? Sản phẩm đã gắn thuộc tính này vẫn giữ nguyên."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="a-icon-btn a-icon-danger" title="Xóa"><%- I('trash') %></button></form>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('_footer') %>
