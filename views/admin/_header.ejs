<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= title %> | Admin <%= s.site_name %></title>
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin">
<% const B = locals.adminBadges || {}; const P = locals.path || ''; const act = (p) => (p === '/' ? P === '/' : P.startsWith(p)) ? 'active' : ''; %>
<aside class="a-side" id="aSide">
  <a href="/admin" class="a-logo"><%- I('gear') %> <span>ADMIN PANEL</span></a>
  <nav>
    <div class="a-group">Tổng quan</div>
    <a href="/admin" class="<%= act('/') %>"><%- I('chart') %> Dashboard</a>
    <div class="a-group">Sản phẩm</div>
    <a href="/admin/games" class="<%= act('/games') %>"><%- I('gamepad') %> Game (Cấp 1)</a>
    <a href="/admin/categories" class="<%= act('/categories') %>"><%- I('folder') %> Danh mục con (Cấp 2)</a>
    <a href="/admin/products" class="<%= act('/products') %>"><%- I('receipt') %> Sản phẩm / Thẻ (Cấp 3)</a>
    <div class="a-group">Kinh doanh</div>
    <a href="/admin/orders" class="<%= act('/orders') %>"><%- I('bag') %> Đơn hàng</a>
    <a href="/admin/deposits" class="<%= act('/deposits') %>"><%- I('card') %> Nạp tiền <% if (B.deposits) { %><span class="a-badge"><%= B.deposits %></span><% } %></a>
    <a href="/admin/bank" class="<%= act('/bank') %>"><%- I('bank') %> GD ngân hàng <% if (B.bank) { %><span class="a-badge warn"><%= B.bank %></span><% } %></a>
    <a href="/admin/coupons" class="<%= act('/coupons') %>"><%- I('ticket') %> Mã giảm giá</a>
    <a href="/admin/users" class="<%= act('/users') %>"><%- I('users') %> Người dùng</a>
    <div class="a-group">Giao diện</div>
    <a href="/admin/banners" class="<%= act('/banners') %>"><%- I('image') %> Banner & Sidebar</a>
    <a href="/admin/settings" class="<%= act('/settings') %>"><%- I('tools') %> Cài đặt</a>
    <div class="a-group">Hệ thống</div>
    <a href="/admin/security" class="<%= act('/security') %>"><%- I('shield') %> Bảo mật</a>
    <a href="/admin/logs" class="<%= act('/logs') %>"><%- I('list') %> Nhật ký</a>
    <a href="/admin/maintenance" class="<%= act('/maintenance') %>"><%- I('broom') %> Bảo trì dữ liệu</a>
  </nav>
</aside>
<div class="a-main">
  <header class="a-top">
    <button class="a-btn a-ghost a-menu" data-toggle-side aria-label="Menu"><%- I('menu') %></button>
    <h1><%= title %></h1>
    <div class="a-top-right">
      <a href="/" target="_blank" class="a-btn a-ghost"><%- I('globe') %> Xem web</a>
      <a href="/admin/profile" class="a-btn a-ghost"><%- I('user') %> <%= user.username %></a>
      <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="a-btn a-danger">Đăng xuất</button></form>
    </div>
  </header>
  <div class="a-content">
  <% (locals.flashes || []).forEach(f => { %><div class="a-alert a-alert-<%= f.type %>"><%= f.msg %></div><% }) %>
