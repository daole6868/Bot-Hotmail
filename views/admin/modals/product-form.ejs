<% const isVip = p.type === 'account'; const R = '<span class="req" title="Bắt buộc">*</span>'; %>
<form method="post" action="/admin/products/save" enctype="multipart/form-data" class="a-form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_back" value="">
  <input type="hidden" name="id" value="<%= p.id || '' %>">
  <input type="hidden" name="category_id" value="<%= cat.id %>">

  <div class="a-form-context">
    <span class="a-folder"><%- I('folder') %></span>
    <div class="a-minw0"><small class="a-muted"><%= cat.game_name %></small><b><%= cat.name %></b></div>
    <% if (isVip) { %><span class="a-type-badge vip"><%- I('star') %> VIP · bán 1 lần</span>
    <% } else { %><span class="a-type-badge reroll"><%- I('refresh') %> Reroll · bán tới khi hết acc</span><% } %>
  </div>

  <label>Tên sản phẩm <%- R %></label>
  <input name="title" required maxlength="200" value="<%= p.title || '' %>" placeholder="<%= isVip ? 'VD: Acc 80 tướng 120 skin rank Cao Thủ' : 'VD: Random Liên Quân 20K' %>" autofocus>
  <div class="a-row a-row-3">
    <div><label>Giá bán (đ) <%- R %></label><input type="number" name="price" required min="0" value="<%= p.price ?? '' %>" placeholder="0"></div>
    <div><label>Giá gốc <small class="a-muted">(gạch ngang)</small></label><input type="number" name="old_price" min="0" value="<%= p.old_price || '' %>"></div>
    <div><label>Mã SP <small class="a-muted">(trống = tự tạo)</small></label><input name="code" maxlength="20" value="<%= p.code || '' %>"></div>
  </div>

  <% if (isVip) { %>
    <div class="a-fieldset">
      <div class="a-fieldset-title"><%- I('key') %> Thông tin acc giao cho khách <small class="a-muted">(mã hóa, chỉ người mua xem được)</small></div>
      <div class="a-row">
        <div><label>Tài khoản <%- R %></label><input name="acc_user" required maxlength="200" value="<%= p.user || '' %>" autocomplete="off" placeholder="Tên đăng nhập / email / SĐT"></div>
        <div><label>Mật khẩu <%- R %></label><input name="acc_pass" required maxlength="200" value="<%= p.pass || '' %>" autocomplete="off" placeholder="Mật khẩu acc"></div>
      </div>
      <label>Thông tin thêm <small class="a-muted">(không bắt buộc: email gốc, mã bảo mật...)</small></label>
      <textarea name="acc_extra" rows="2" maxlength="3000"><%= p.extra || '' %></textarea>
    </div>
  <% } else { %>
    <div class="a-fieldset">
      <div class="a-fieldset-title"><%- I('box') %> Danh sách acc trong kho
        <% if (p.id) { %><small class="a-muted">đang còn <b><%= p.stockLeft %></b> acc · <a href="/admin/products/<%= p.id %>/edit">xem / xóa acc trong kho</a></small><% } %></div>
      <label><%= p.id ? 'Thêm acc vào kho' : 'Các acc' %> <%- p.id ? '' : R %> <small class="a-muted">mỗi dòng 1 acc: <code>tài khoản | mật khẩu</code></small></label>
      <textarea name="stock_lines" rows="6" <%= p.id ? '' : 'required' %> placeholder="acc001 | matkhau001&#10;acc002 | matkhau002&#10;acc003 | matkhau003" data-count-lines></textarea>
      <div class="a-muted a-small" data-line-count>0 acc</div>
    </div>
  <% } %>

  <label>Ảnh sản phẩm <small class="a-muted">(tối đa 10 ảnh<%= p.imageList.length ? ', bỏ tick “Giữ” để xóa ảnh cũ' : '' %>)</small></label>
  <div class="a-images" data-preview-multi>
    <% p.imageList.forEach(img => { %><label class="a-img-keep"><img src="<%= img %>" alt=""><span><input type="checkbox" name="keep_images" value="<%= img %>" checked> Giữ</span></label><% }) %>
  </div>
  <input type="file" name="images" accept="image/*" multiple data-preview-multi-input>

  <label>Thuộc tính hiển thị <small class="a-muted">(Rank, Skin, Tướng...)</small></label>
  <div data-attr-list>
    <% (p.attrList.length ? p.attrList : [{k:'',v:''}]).forEach(a => { %>
      <div class="a-attr"><input name="attr_k" placeholder="Tên" value="<%= a.k %>"><input name="attr_v" placeholder="Giá trị" value="<%= a.v %>"><button type="button" class="a-icon-btn a-icon-danger" data-remove-attr aria-label="Xóa"><%- I('x') %></button></div>
    <% }) %>
  </div>
  <button type="button" class="a-btn a-ghost a-sm" data-add-attr><%- I('plus') %> Thêm thuộc tính</button>

  <label>Mô tả</label>
  <textarea name="description" rows="3" maxlength="5000"><%= p.description || '' %></textarea>

  <div class="a-row">
    <div><label>Trạng thái</label>
      <select name="status">
        <option value="available" <%= p.status === 'available' ? 'selected' : '' %>>Đang bán</option>
        <option value="hidden" <%= p.status === 'hidden' ? 'selected' : '' %>>Ẩn</option>
        <% if (isVip) { %><option value="sold" <%= p.status === 'sold' ? 'selected' : '' %>>Đã bán</option><% } %>
      </select></div>
    <div class="a-check-cell"><label class="a-check"><input type="checkbox" name="is_featured" <%= p.is_featured ? 'checked' : '' %>> Nổi bật (nhãn Hot, hiện trang chủ)</label></div>
  </div>

  <div class="a-modal-foot">
    <span class="a-muted a-small a-foot-note"><%- R %> là thông tin bắt buộc</span>
    <button type="button" class="a-btn a-ghost" data-modal-close>Hủy</button>
    <button class="a-btn a-primary"><%- I('save') %> <%= p.id ? 'Lưu thay đổi' : 'Thêm sản phẩm' %></button>
  </div>
</form>
