<% const R = '<span class="req" title="Bắt buộc">*</span>'; %>
<form method="post" action="/admin/attributes/save" class="a-form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="_back" value="">
  <input type="hidden" name="id" value="<%= a ? a.id : '' %>">
  <label>Tên thuộc tính <%- R %></label>
  <input name="name" required maxlength="60" value="<%= a ? a.name : '' %>" autofocus>
  <label>Các giá trị <%- R %> <small class="a-muted">mỗi dòng 1 giá trị, tự bỏ giá trị trùng</small></label>
  <textarea name="values" rows="8" required data-count-lines data-count-unit="giá trị"><%= a ? a.values.join('\n') : '' %></textarea>
  <div class="a-muted a-small" data-line-count><%= a ? a.values.length : 0 %> giá trị</div>
  <div class="a-modal-foot">
    <span class="a-muted a-small a-foot-note"><%- R %> là thông tin bắt buộc</span>
    <button type="button" class="a-btn a-ghost" data-modal-close>Hủy</button>
    <button class="a-btn a-primary"><%- I('save') %> <%= a ? 'Lưu thay đổi' : 'Thêm thuộc tính' %></button>
  </div>
</form>
