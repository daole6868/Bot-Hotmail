<%- include('_header') %>
<div class="a-section-head">
  <div>
    <h3><a href="/admin/boost/c/<%= c.parent_id %>" class="a-muted"><%= c.game_name %> › <%= c.parent_name %></a> › <%= c.name %></h3>
    <p class="a-muted a-small">Kéo nút ⠿ để đổi thứ tự gói. Tắt “Nhận đơn” để tạm ngưng gói mà vẫn hiển thị.</p>
  </div>
  <div class="a-actions">
    <a class="a-btn a-ghost" href="/game/<%= c.game_slug %>/<%= c.parent_slug %>/<%= c.slug %>" target="_blank" rel="noopener"><%- I('eye') %> Xem ngoài web</a>
    <button type="button" class="a-btn a-primary" data-modal-url="/admin/boost/packages/form?category_id=<%= c.id %>" data-modal-title="Thêm gói – <%= c.name %>"><%- I('plus') %> Thêm gói</button>
  </div>
</div>
<div class="a-card">
  <div class="a-table-wrap">
    <table class="a-table">
      <thead><tr><th class="a-w-move"></th><th>Gói</th><th class="a-num">Giá</th><th>SL / đơn vị</th><th class="a-num">Đã thuê</th><th class="a-center">Nhận đơn</th><th class="a-center">Hiển thị</th><th class="a-right">Thao tác</th></tr></thead>
      <tbody>
      <% if (!packages.length) { %><tr><td colspan="8" class="a-empty">Chưa có gói nào.</td></tr><% } %>
      <% packages.forEach((p, i) => { %>
        <tr class="<%= p.is_active ? '' : 'a-row-off' %>">
          <td><%- include('partials/move', { kind: 'boost-packages', id: p.id, first: i === 0, last: i === packages.length - 1 }) %></td>
          <td><div class="a-item">
            <% if (p.image) { %><img src="<%= p.image %>" class="a-avatar sm" alt="" loading="lazy"><% } else { %><span class="a-bx-ico" style="--ic:<%= p.icon_color %>"><%- I(p.icon) %></span><% } %>
            <div><b><%= p.name %></b><div class="a-muted a-small"><%= p.eta ? '⏱ ' + p.eta : '' %></div></div>
          </div></td>
          <td class="a-num"><b><%= H.money(p.price) %></b><% if (p.old_price) { %><div class="a-muted a-small"><del><%= H.money(p.old_price) %></del></div><% } %></td>
          <td class="a-small"><%= p.min_qty %>–<%= p.max_qty %> <%= p.unit %></td>
          <td class="a-num"><%= p.sold_count.toLocaleString('vi-VN') %></td>
          <td class="a-center"><label class="a-switch" title="Nhận đơn"><input type="checkbox" data-toggle-url="/admin/boost/packages/<%= p.id %>/pause" data-on-msg="Đã mở lại nhận đơn" data-off-msg="Đã tạm ngưng nhận đơn" <%= p.is_paused ? '' : 'checked' %>><span></span></label></td>
          <td class="a-center"><%- include('partials/switch', { kind: 'boost-packages', id: p.id, on: p.is_active, disabled: false }) %></td>
          <td class="a-right"><div class="a-actions">
            <button type="button" class="a-icon-btn" data-modal-url="/admin/boost/packages/form?id=<%= p.id %>" data-modal-title="Sửa gói" title="Sửa"><%- I('edit') %></button>
            <form method="post" action="/admin/boost/packages/<%= p.id %>/delete" data-confirm="Xóa gói “<%= p.name %>”?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="a-icon-btn a-icon-danger" title="Xóa"><%- I('trash') %></button></form>
          </div></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('_footer') %>
