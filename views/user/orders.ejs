<%- include('../partials/header') %>
<%- include('../partials/user-nav') %>
<div class="card">
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Mã đơn</th><th>Sản phẩm</th><th>Giá</th><th>Giảm</th><th>Thanh toán</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead>
    <tbody>
    <% if (!result.rows.length) { %><tr><td colspan="8" class="center muted">Chưa có đơn hàng</td></tr><% } %>
    <% result.rows.forEach(o => { %>
      <tr>
        <td><b><%= o.order_code %></b></td>
        <td><%= o.product_title %><div class="muted small"><%= o.game_name %></div></td>
        <td><%= H.money(o.price) %></td>
        <td><%= o.discount ? '-' + H.money(o.discount) : '—' %><% if (o.coupon_code) { %><div class="muted small"><%= o.coupon_code %></div><% } %></td>
        <td class="price"><%= H.money(o.total) %></td>
        <td><span class="status status-<%= o.status %>"><%= o.status === 'completed' ? 'Thành công' : 'Đã hoàn tiền' %></span></td>
        <td class="muted small"><%= H.fmtDate(o.created_at) %></td>
        <td><a class="btn btn-xs btn-primary" href="/user/orders/<%= o.order_code %>">Xem acc</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/pagination', { result, query }) %>
<%- include('../partials/footer') %>
