<%- include('../partials/header') %>
<%- include('../partials/user-nav') %>
<% if (keepDays) { %><div class="alert alert-warning small as-keep"><%- I('alert') %><span>Dữ liệu mỗi đơn chỉ được lưu <b><%= keepDays %> ngày</b> kể từ lúc mua. Hãy tải file về máy để không bị mất.</span></div><% } %>
<div class="card">
  <div class="table-wrap">
  <table class="table table-cards">
    <thead><tr><th>Mã đơn</th><th>Sản phẩm</th><th>Số lượng</th><th>Thanh toán</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead>
    <tbody>
    <% if (!result.rows.length) { %><tr><td colspan="7" class="center muted tc-empty">Chưa có đơn hàng</td></tr><% } %>
    <% result.rows.forEach(o => { %>
      <tr>
        <td class="tc-head"><b><%= o.code %></b></td>
        <td class="tc-full"><%= o.title %></td>
        <td data-label="Số lượng"><%= (o.status === 'completed' ? o.delivered : o.qty).toLocaleString('vi-VN') %></td>
        <td data-label="Thanh toán" class="price"><b><%= H.money(o.total - o.refunded) %></b></td>
        <td data-label="Trạng thái"><span class="status as-st-<%= o.status %>"><%= STATUS[o.status] || o.status %></span></td>
        <td data-label="Thời gian"><%= H.fmtDate(o.created_at) %></td>
        <td class="tc-act"><a class="btn btn-sm btn-ghost" href="/user/api-orders/<%= o.code %>">Xem</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/pagination', { result, query }) %>
<%- include('../partials/footer') %>
