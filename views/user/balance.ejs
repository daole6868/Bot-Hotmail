<%- include('../partials/header') %>
<%- include('../partials/user-nav') %>
<div class="card">
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>Thời gian</th><th>Loại</th><th>Số tiền</th><th>Số dư sau</th><th>Nội dung</th></tr></thead>
    <% const tl = { deposit: 'Nạp tiền', purchase: 'Mua hàng', refund: 'Hoàn tiền', admin: 'Điều chỉnh' }; %>
    <% if (!result.rows.length) { %><tr><td colspan="5" class="center muted">Chưa có biến động</td></tr><% } %>
    <% result.rows.forEach(l => { %>
      <tr><td class="muted small"><%= H.fmtDate(l.created_at) %></td><td><%= tl[l.type] || l.type %></td>
        <td class="<%= l.amount >= 0 ? 'plus' : 'minus' %>"><%= l.amount >= 0 ? '+' : '' %><%= H.money(l.amount) %></td>
        <td><%= H.money(l.balance_after) %></td><td><%= l.note %> <span class="muted small"><%= l.ref %></span></td></tr>
    <% }) %>
  </table>
  </div>
</div>
<%- include('../partials/pagination', { result, query }) %>
<%- include('../partials/footer') %>
