<%- include('../partials/header') %>
<%- include('../partials/user-nav') %>
<div class="chips bo-filter">
  <a href="/user/boost" class="chip <%= !status ? 'active' : '' %>">Tất cả</a>
  <% Object.entries(STATUS).forEach(([k, v]) => { %><a href="/user/boost?status=<%= k %>" class="chip <%= status === k ? 'active' : '' %>"><%= v.label %></a><% }) %>
</div>
<div class="card">
  <div class="table-wrap">
  <table class="table table-cards">
    <thead><tr><th>Mã đơn</th><th>Dịch vụ</th><th>Thanh toán</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead>
    <tbody>
    <% if (!result.rows.length) { %><tr><td colspan="6" class="center muted tc-empty">Chưa có đơn cày thuê</td></tr><% } %>
    <% result.rows.forEach(o => { %>
      <tr>
        <td class="tc-head"><b><%= o.code %></b></td>
        <td class="tc-full"><%= o.items %><div class="muted small"><%= o.game_name %></div></td>
        <td data-label="Thanh toán" class="price"><%= H.money(o.total) %></td>
        <td data-label="Trạng thái"><span class="bo-st bo-<%= STATUS[o.status].tone %>"><%= STATUS[o.status].label %></span></td>
        <td data-label="Thời gian" class="muted small"><%= H.fmtDate(o.created_at) %></td>
        <td class="tc-action"><a class="btn btn-xs btn-primary" href="/user/boost/<%= o.code %>">Chi tiết</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
</div>
<%- include('../partials/pagination', { result, query }) %>
<%- include('../partials/footer') %>
