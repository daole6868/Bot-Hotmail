<%- include('../partials/header') %>

<% const cDesc = (category.description || '').trim(); %>
<%- include('../partials/page-head', { hero: (locals.cardCfg || {}).hero2 !== false, img: category.image || game.image, name: category.name,
  sub: game.name + ' · ' + result.total.toLocaleString('vi-VN') + ' sản phẩm', desc: cDesc && cDesc !== category.name + ' - ' + game.name && cDesc !== category.name ? cDesc : '',
  icon: category.sale_type === 'reroll' ? 'refresh' : 'star', color: game.color }) %>

<%- include('../partials/search-filter', { filter, query }) %>

<% if (!result.rows.length) { %>
  <div class="empty">Không có sản phẩm phù hợp.</div>
<% } %>
<div class="product-grid" data-sf-grid data-page="<%= result.page %>" data-more="<%= result.page < result.pages ? 1 : 0 %>">
  <% result.rows.forEach(p => { %><%- include('../partials/product-card', { p, ht: 'h2' }) %><% }) %>
</div>
<div class="sf-more" data-sf-more hidden><span class="sf-spin"></span> Đang tải thêm...</div>
<div data-sf-pager><%- include('../partials/pagination', { result, query: pageQuery }) %></div>

<script src="/js/filter.js?v=<%= locals.assetV || 1 %>" defer></script>
<%- include('../partials/footer') %>
