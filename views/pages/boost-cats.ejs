<%- include('../partials/header') %>
<section class="page-hero" style="--c: <%= game.color %>">
  <% if (game.image) { %><img src="<%= game.image %>" alt="<%= game.name %>"><% } %>
  <div><h1><%= s.boost_tile_title || 'Cày thuê' %> <%= game.name %></h1><p><%= s.boost_tile_desc %></p></div>
</section>
<section class="section">
  <div class="section-head"><h2><%- I('g-swords') %> Chọn dịch vụ</h2></div>
  <div class="bx-list bx-list-<%= disp.mode %>" style="--cols-pc:<%= disp.colsPc %>;--cols-m:<%= disp.colsM %>" data-scroll-max="<%= disp.max %>">
    <% categories.forEach(c => { %><%- include('../partials/boost/item', { it: c, kind: 'cat', mode: disp.mode, href: `/game/${game.slug}/cay-thue/${c.slug}`, inCart: 0, loginUrl: '' }) %><% }) %>
  </div>
</section>
<% if (coupons.length) { %>
<section class="section">
  <div class="section-head"><h2><%- I('gift') %> Mã giảm giá cho cày thuê</h2></div>
  <%- include('../partials/coupon-list', { coupons }) %>
</section>
<% } %>
<%- include('../partials/footer') %>
