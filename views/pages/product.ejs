<%- include('../partials/header') %>

<div class="product-detail">
  <div class="card gallery" data-gallery>
    <img class="gallery-main" src="<%= p.imageList[0] || '/img/no-image.svg' %>" alt="<%= p.title %>">
    <% if (p.imageList.length > 1) { %>
      <div class="gallery-thumbs">
        <% p.imageList.forEach((img, i) => { %><img src="<%= img %>" alt="Ảnh <%= i + 1 %>" class="<%= i === 0 ? 'active' : '' %>" loading="lazy"><% }) %>
      </div>
    <% } %>
  </div>

  <div class="card buy-box">
    <div class="muted small"><%= p.game_name %> · <%= p.category_name %></div>
    <h1><%= p.title %></h1>
    <div class="muted small">Mã: <b>#<%= p.code %></b> · Lượt xem: <%= p.views %> · Đã bán: <%= p.sold_count %></div>

    <div class="price-big">
      <strong class="price" id="finalPrice" data-price="<%= p.price %>"><%= H.money(p.price) %></strong>
      <% if (p.old_price && p.old_price > p.price) { %><del><%= H.money(p.old_price) %></del><span class="ribbon static">-<%= p.discountPercent %>%</span><% } %>
    </div>

    <% if (p.attrList.length) { %>
      <table class="table attrs-table"><% p.attrList.forEach(a => { %><tr><th><%= a.k %></th><td><%= a.v %></td></tr><% }) %></table>
    <% } %>

    <% const soldOut = p.status !== 'available' || (p.type === 'stock' && !p.stock_left); %>
    <% if (soldOut) { %>
      <div class="alert alert-error">Sản phẩm đã bán hoặc hết hàng.</div>
    <% } else { %>
      <% if (p.type === 'stock') { %><div class="alert alert-info">Kho còn <b><%= p.stock_left %></b> mã. Mã sẽ được giao ngay sau khi thanh toán.</div><% } %>
      <form method="post" action="/product/<%= p.code %>/buy" data-buy-form data-confirm="Xác nhận mua sản phẩm này?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="label">Mã giảm giá (nếu có)</label>
        <div class="input-group">
          <input type="text" name="coupon" id="couponInput" maxlength="32" placeholder="Nhập mã KM" autocomplete="off" data-product="<%= p.code %>">
          <button type="button" class="btn btn-ghost" id="couponCheck">Áp dụng</button>
        </div>
        <div class="small" id="couponMsg"></div>
        <% if (user) { %>
          <div class="muted small">Số dư của bạn: <b><%= H.money(user.balance) %></b>
            <% if (user.balance < p.price) { %> · <a href="/user/deposit">Nạp thêm</a><% } %></div>
          <button type="submit" class="btn btn-lg btn-block btn-accent"><%- I('cart') %> MUA NGAY</button>
        <% } else { %>
          <a href="/login" class="btn btn-lg btn-block btn-accent">Đăng nhập để mua</a>
        <% } %>
      </form>
    <% } %>
    <% if (coupons.length) { %>
      <div class="mini-coupons">
        <% coupons.slice(0, 4).forEach(c => { %><button type="button" class="chip" data-fill-coupon="<%= c.code %>"><%- I('ticket') %> <%= c.code %></button><% }) %>
      </div>
    <% } %>
  </div>
</div>

<% if (p.description) { %>
<section class="section card pad">
  <h2>Mô tả</h2>
  <div class="prewrap"><%= p.description %></div>
</section>
<% } %>

<% if (related.length) { %>
<section class="section">
  <div class="section-head"><h2>Sản phẩm tương tự</h2></div>
  <div class="product-grid"><% related.forEach(r => { %><%- include('../partials/product-card', { p: r }) %><% }) %></div>
</section>
<% } %>

<%- include('../partials/footer') %>
