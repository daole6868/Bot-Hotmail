<% const D = { mode: s.boost_pkg_mode === 'icon' ? 'icon' : 'image', pc: Math.min(6, Math.max(1, +s.boost_pkg_cols_pc || 4)), m: Math.min(3, Math.max(1, +s.boost_pkg_cols_m || 2)) }; %>
<section class="section">
  <div class="section-head"><h2><%- I('g-swords') %> <%= block.title || 'Cày thuê nổi bật' %></h2></div>
  <div class="bx-list bx-list-<%= D.mode %>" style="--cols-pc:<%= D.pc %>;--cols-m:<%= D.m %>">
    <% block.packages.forEach(p => { const href = `/game/${p.game_slug}/${p.parent_slug}/${p.category_slug}`;
         const price = `${p.old_price && p.old_price > p.price ? `<del class="muted small">${H.money(p.old_price)}</del> ` : ''}<b class="price">${H.money(p.price)}</b><span class="muted small">/${p.unit}</span>`; %>
      <a href="<%= href %>" class="bx-item bx-<%= D.mode %> card">
        <% if (D.mode === 'image') { %>
          <div class="bx-thumb"><% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% } else { %><span class="bx-thumb-ico" style="--ic:<%= p.icon_color %>"><%- I(p.icon) %></span><% } %></div>
          <div class="bx-body">
            <h3><%= p.name %></h3>
            <span class="muted small"><%= p.game_name %> · <%= p.category_name %></span>
            <div class="bx-foot"><span class="bx-price"><%- price %></span></div>
          </div>
        <% } else { %>
          <span class="bx-ico" style="--ic:<%= p.icon_color %>"><%- I(p.icon) %></span>
          <div class="bx-body"><h3><%= p.name %></h3><span class="muted small"><%= p.game_name %> · <%= p.category_name %></span></div>
          <div class="bx-side"><span class="bx-price"><%- price %></span><%- I('chevron-right') %></div>
        <% } %>
      </a>
    <% }) %>
  </div>
</section>
