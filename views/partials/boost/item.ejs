<%#
  1 ô danh mục / gói cày thuê.  it, kind: 'cat' | 'pkg', mode: 'image' | 'icon', href (danh mục), inCart (số lượng trong giỏ), loginUrl
%>
<% const isCat = kind === 'cat';
   const icoBox = `<span class="bx-ico" style="--ic:${it.icon_color || '#8b5cf6'}">${I(it.icon || 'star')}</span>`;
   const priceHtml = isCat
     ? (it.min_price != null ? `<span class="muted small">Từ</span> <b class="price">${H.money(it.min_price)}</b>` : '<span class="muted small">Chưa có gói</span>')
     : `${it.old_price && it.old_price > it.price ? `<del class="muted small">${H.money(it.old_price)}</del> ` : ''}<b class="price">${H.money(it.price)}</b><span class="muted small">/${it.unit}</span>`;
%>
<% if (isCat) { %>
  <a href="<%= href %>" class="bx-item bx-<%= mode %> card">
    <% if (mode === 'image') { %>
      <div class="bx-thumb"><% if (it.image) { %><img src="<%= it.image %>" alt="<%= it.name %>" loading="lazy"><% } else { %><span class="bx-thumb-ico" style="--ic:<%= it.icon_color %>"><%- I(it.icon) %></span><% } %></div>
      <div class="bx-body">
        <h3><%= it.name %></h3>
        <% if (it.description) { %><p class="muted small bx-desc"><%= it.description %></p><% } %>
        <div class="bx-foot"><span class="bx-price"><%- priceHtml %></span><span class="bx-meta"><%- I('layers') %> <%= it.package_count %> gói</span></div>
      </div>
    <% } else { %>
      <%- icoBox %>
      <div class="bx-body">
        <h3><%= it.name %></h3>
        <p class="muted small bx-desc"><%= it.description || (it.package_count + ' gói dịch vụ') %></p>
      </div>
      <div class="bx-side"><span class="bx-price"><%- priceHtml %></span><%- I('chevron-right') %></div>
    <% } %>
  </a>
<% } else { %>
  <div class="bx-item bx-<%= mode %> card<%= it.is_paused ? ' is-paused' : '' %>" data-pkg="<%= it.id %>">
    <% if (mode === 'image') { %>
      <div class="bx-thumb"><% if (it.image) { %><img src="<%= it.image %>" alt="<%= it.name %>" loading="lazy"><% } else { %><span class="bx-thumb-ico" style="--ic:<%= it.icon_color %>"><%- I(it.icon) %></span><% } %>
        <% if (inCart) { %><span class="bx-incart" data-incart><%- I('cart') %> <%= inCart %></span><% } %></div>
      <div class="bx-body">
        <h3><%= it.name %></h3>
        <% if (it.eta) { %><div class="bx-eta"><%- I('clock') %> <%= it.eta %></div><% } %>
        <% if (it.description) { %><p class="muted small bx-desc" data-expand><%= it.description %></p><% } %>
        <div class="bx-foot"><span class="bx-price"><%- priceHtml %></span></div>
    <% } else { %>
      <%- icoBox %>
      <div class="bx-body">
        <h3><%= it.name %> <% if (inCart) { %><span class="bx-incart" data-incart><%- I('cart') %> <%= inCart %></span><% } %></h3>
        <div class="bx-sub"><% if (it.eta) { %><span><%- I('clock') %> <%= it.eta %></span><% } %><span class="bx-price"><%- priceHtml %></span></div>
        <% if (it.description) { %><p class="muted small bx-desc" data-expand><%= it.description %></p><% } %>
    <% } %>
        <div class="bx-act">
          <% if (it.is_paused) { %><span class="bx-paused"><%- I('clock') %> Tạm ngưng nhận đơn</span>
          <% } else if (!user) { %><a class="btn btn-sm btn-ghost" href="<%= loginUrl %>"><%- I('user') %> Đăng nhập để thuê</a>
          <% } else { %><button type="button" class="btn btn-sm btn-primary" data-boost-add="<%= it.id %>"><%- I('cart') %> Thêm vào giỏ</button><% } %>
        </div>
      </div>
  </div>
<% } %>
