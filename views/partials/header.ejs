<%
  const S = locals.s || {};
  const NAV = locals.nav || { games: [], sideLeft: [], sideRight: [] };
  const U = locals.user;
  const siteName = S.site_name || 'ShopAcc';
  const pageTitle = locals.title ? `${locals.title} | ${siteName}` : (S.seo_title || (siteName + (S.site_slogan ? ' - ' + S.site_slogan : '')));
  // Khung xem trước khi chia sẻ link (Zalo, Facebook...) và mô tả trên Google
  const base = String(locals.baseUrl || '').replace(/\/$/, '');
  const abs = (u) => !u ? '' : /^https?:\/\//.test(u) ? u : base + u;
  const metaDesc = String(locals.metaDesc || S.site_description || '').slice(0, 300);
  const metaImage = abs(locals.metaImage || S.og_image || S.logo);
%><!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= metaDesc %>">
  <meta property="og:type" content="<%= locals.metaImage ? 'product' : 'website' %>">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= metaDesc %>">
  <meta property="og:url" content="<%= base + (locals.currentUrl || '/') %>">
  <% if (metaImage) { %><meta property="og:image" content="<%= metaImage %>">
  <meta name="twitter:card" content="summary_large_image"><% } %>
  <meta name="csrf-token" content="<%= locals.csrfToken || '' %>">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <script src="/js/theme-init.js?v=<%= locals.assetV || 1 %>"></script>
  <link rel="stylesheet" href="/css/fonts.css?v=<%= locals.assetV || 1 %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetV || 1 %>">
</head>
<body>
<header class="topbar">
  <div class="container topbar-inner">
    <button class="icon-btn menu-toggle" data-toggle="#mobileNav" aria-label="Menu"><%- I('menu') %></button>
    <a href="/" class="logo">
      <% if (S.logo) { %><img src="<%= S.logo %>" alt="<%= siteName %>"><% } else { %><span class="logo-mark"><%- I('gamepad') %></span><span><%= siteName %></span><% } %>
    </a>
    <form class="search" action="/search" method="get">
      <input type="search" name="q" placeholder="Tìm acc, game, mã sản phẩm..." value="<%= locals.q || '' %>" maxlength="60">
      <button type="submit" aria-label="Tìm"><%- I('search') %></button>
    </form>
    <nav class="top-actions">
      <button type="button" class="icon-round" data-ui-open title="Cài đặt giao diện" aria-label="Cài đặt giao diện"><%- I('palette') %></button>
      <a href="/khuyen-mai" class="hide-sm"><%- I('gift') %> Khuyến mãi</a>
      <% if (U) { %>
        <a href="/user/deposit" class="btn btn-sm btn-accent top-balance"><%- I('card') %> <%= H.money(U.balance) %></a>
        <div class="dropdown">
          <button class="btn btn-sm btn-ghost top-user" data-toggle="#userMenu"><%- I('user') %> <span class="top-uname"><%= U.username %></span> <%- I('caret-down') %></button>
          <div class="dropdown-menu" id="userMenu">
            <% if (U.role === 'admin') { %><a href="/admin"><%- I('gear') %> Trang quản trị</a><% } %>
            <a href="/user">Tài khoản</a>
            <a href="/user/orders">Lịch sử mua</a>
            <a href="/user/deposit">Nạp tiền</a>
            <a href="/user/balance">Biến động số dư</a>
            <a href="/user/security">Bảo mật</a>
            <button type="button" data-ui-open><%- I('palette') %> Cài đặt giao diện</button>
            <div class="dd-sep"></div>
            <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= locals.csrfToken %>"><button type="submit">Đăng xuất</button></form>
          </div>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-ghost">Đăng nhập</a>
        <a href="/register" class="btn btn-sm btn-primary">Đăng ký</a>
      <% } %>
    </nav>
  </div>
  <nav class="catbar" id="mobileNav">
    <div class="container catbar-inner">
      <a href="/" class="<%= locals.currentPath === '/' ? 'active' : '' %>"><%- I('home') %> Trang chủ</a>
      <% NAV.games.forEach(g => { %>
        <a href="/game/<%= g.slug %>" class="<%= (locals.currentPath || '').startsWith('/game/' + g.slug) ? 'active' : '' %>"><%= g.name %><% if (g.is_hot) { %> <span class="badge-hot">HOT</span><% } %></a>
      <% }) %>
      <a href="/user/deposit"><%- I('card') %> Nạp tiền</a>
      <button type="button" class="catbar-ui" data-ui-open><%- I('palette') %> Cài đặt giao diện</button>
    </div>
  </nav>
</header>

<% if (S.notice) { %>
<div class="notice"><div class="container"><div class="marquee"><span><%= S.notice %></span></div></div></div>
<% } %>

<div class="container layout">
  <% const bzL = H.bannerSize(S, 'sidebar_left'); %>
  <aside class="side side-left" style="--ar: <%= bzL.w %> / <%= bzL.h %>">
    <% NAV.sideLeft.forEach(b => { %>
      <a href="<%= b.link || '#' %>" class="side-banner"><img src="<%= b.image %>" alt="<%= b.title || '' %>" loading="lazy"></a>
    <% }) %>
  </aside>
  <main class="main">
    <% if (locals.breadcrumb) { %>
      <nav class="breadcrumb"><a href="/">Trang chủ</a><% breadcrumb.forEach(b => { %> <span><%- I('chevron-right') %></span> <% if (b.url) { %><a href="<%= b.url %>"><%= b.name %></a><% } else { %><strong><%= b.name %></strong><% } %><% }) %></nav>
    <% } %>
    <% (locals.flashes || []).forEach(f => { %>
      <div class="alert alert-<%= f.type %>"><%= f.msg %></div>
    <% }) %>
