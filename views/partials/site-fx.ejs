<% const FB = locals.siteFx && locals.siteFx.banner; if (FB) { %><div class="fx-ribbon<%= FB.marquee ? ' is-marquee' : '' %>" style="--ra:<%= FB.rb[0] %>;--rm:<%= FB.rb[1] %>;--rc:<%= FB.rb[2] %>"><% if (FB.marquee) { %><span class="fx-mq"><%= FB.text %><% if (FB.cd) { %> · <%= FB.cdLabel %> <b data-fx-cd="<%= FB.cd %>"></b><% } %></span><% } else { %><%= FB.text %><% if (FB.cd) { %> <small><%= FB.cdLabel %></small><b data-fx-cd="<%= FB.cd %>"></b><% } %><% } %></div><% } %>
